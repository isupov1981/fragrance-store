# Hostinger Business (Node.js Web App) + external Postgres (Neon recommended)
# Copy values into hPanel → Websites → your Node app → Environment variables.
# Do not commit real secrets.

# --- Required ---
# Pooled Neon URI (hostname contains -pooler) — used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct Neon URI (no -pooler) — required for prisma migrate
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate-at-least-32-random-characters-here"
NEXT_PUBLIC_SITE_URL="https://parfums.cloud"
NEXT_PUBLIC_STORE_CURRENCY="ILS"
NEXT_PUBLIC_FX_EUR="0.92"
NEXT_PUBLIC_FX_ILS="3.72"

ADMIN_EMAIL="admin@parfums.cloud"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Store administrator"
ADMIN_ROLE="ADMIN"

# Optional: apply pending Prisma migrations during Hostinger build (default off)
# HOSTINGER_MIGRATE_ON_BUILD="true"

# Optional Prisma pool size on the Node process (default 5)
# PRISMA_CONNECTION_LIMIT="5"

# --- Media (strongly recommended on shared Node hosting — disk is not durable) ---
# Cloudflare R2 example: set S3_ENDPOINT to your R2 endpoint, S3_FORCE_PATH_STYLE=true
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="parfums-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://media.parfums.cloud"
S3_FORCE_PATH_STYLE="true"

# --- Payments (leave empty for demo checkout) ---
# Grow Light API — add after Israeli osek registration. Takes precedence over Stripe.
# GROW_USER_ID + GROW_PAGE_CODE + GROW_WEBHOOK_SECRET are all required.
GROW_USER_ID=""
GROW_PAGE_CODE=""
GROW_WEBHOOK_SECRET=""
GROW_SANDBOX="true"
# GROW_API_BASE="https://sandbox.meshulam.co.il/api/light/server/1.0"

# Stripe (optional fallback; Israel merchant accounts are currently unavailable)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email (Hostinger mailbox: Emails → Create email account) ---
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="orders@parfums.cloud"
SMTP_PASSWORD=""
EMAIL_FROM="The Perfume Room <orders@parfums.cloud>"
ORDER_FROM_EMAIL="orders@parfums.cloud"
ORDER_ADMIN_EMAIL="admin@parfums.cloud"

# --- Analytics (optional) ---
# Default before an admin toggles Ordering in /admin (Overview or Settings).
# Once saved in the database, that value wins without a rebuild.
NEXT_PUBLIC_ORDERS_ENABLED="false"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Social profiles — replace with real account URLs when ready
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/"
NEXT_PUBLIC_YOUTUBE_URL="https://www.youtube.com/"
NEXT_PUBLIC_TIKTOK_URL="https://www.tiktok.com/"

# --- Hermes Telegram operator (optional, min 24 chars) ---
HERMES_AGENT_TOKEN=""

# Optional readiness probe token for GET /api/admin/health (min 24 chars)
HEALTH_CHECK_TOKEN=""

# After CSP Report-Only looks clean in production logs/reports:
# CSP_ENFORCE="true"
# HSTS_PRELOAD="true"
