DATABASE_URL="postgresql://fragrance:fragrance@localhost:5432/fragrance?schema=public"
DATABASE_URL_UNPOOLED="postgresql://fragrance:fragrance@localhost:5432/fragrance?schema=public"
AUTH_SECRET="dev-only-secret-replace-with-32-plus-random-chars"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="AtelierAdmin2026!"
ADMIN_PASSWORD_HASH=""
ADMIN_NAME="Store administrator"
ADMIN_ROLE="ADMIN"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_CURRENCY="ILS"
NEXT_PUBLIC_FX_EUR="0.92"
NEXT_PUBLIC_FX_ILS="3.72"

# Stripe — unused until a US/EU Stripe entity exists. Leave empty.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Grow Light API — leave empty until an Israeli business (osek) is registered.
# All three are required before Grow is treated as configured (fail-closed webhook).
# Checkout stays in demo mode without these. Webhook: https://parfums.cloud/api/webhooks/grow?secret=...
GROW_USER_ID=""
GROW_PAGE_CODE=""
GROW_WEBHOOK_SECRET=""
GROW_SANDBOX="true"
# GROW_API_BASE="https://sandbox.meshulam.co.il/api/light/server/1.0"

# SMTP — leave SMTP_HOST empty to skip email (noop mailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="orders@example.com"
ORDER_FROM_EMAIL="orders@example.com"
ORDER_ADMIN_EMAIL="admin@example.com"

# Default when no admin setting exists yet. After first save in Admin → Settings
# (or Overview), the database value wins and no rebuild is required.
NEXT_PUBLIC_ORDERS_ENABLED="false"

NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Social profiles (placeholders until real accounts exist)
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/"
NEXT_PUBLIC_YOUTUBE_URL="https://www.youtube.com/"
NEXT_PUBLIC_TIKTOK_URL="https://www.tiktok.com/"

# MinIO (docker compose) — admin uploads go to S3 when bucket + keys are set
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="fragrance-media"
S3_ACCESS_KEY_ID="fragrance"
S3_SECRET_ACCESS_KEY="fragrancesecret"
S3_PUBLIC_BASE_URL="http://127.0.0.1:9000/fragrance-media"
S3_FORCE_PATH_STYLE="true"

# Used only when S3_BUCKET / keys are unset
UPLOAD_DIR="./uploads"

# Hermes Agent (Telegram operator). Min 24 characters. Leave empty to disable /api/agent.
HERMES_AGENT_TOKEN=""

# Optional: bearer token for GET /api/admin/health (min 24 chars). Admin session also works.
HEALTH_CHECK_TOKEN=""

# Browser hardening: CSP starts as Report-Only. Set CSP_ENFORCE=true after verifying reports.
# CSP_ENFORCE="true"
# HSTS_PRELOAD="true"  # only after all subdomains speak HTTPS
